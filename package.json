{
  "name": "pieru",
  "version": "2.1.0",
  "description": "MongoDB query compatible object match",
  "keywords": [
    "query",
    "test",
    "match",
    "mongo",
    "db",
    "mongodb"
  ],
  "license": "MIT",
  "author": "Manuel Stofer <manuel@takimata.ch>",
  "type": "module",
  "main": "./dist/index.js",
  "main:src": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "clean": "rimraf './dist'",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint './src/*.ts'",
    "format": "prettier --write './src'",
    "format:check": "prettier --check './src'",
    "test": "vitest",
    "prebuild": "$npm_execpath run clean",
    "prepack": "$npm_execpath run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
